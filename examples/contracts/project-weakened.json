    {
      "id": "license",
      "statement": "An open-source license is present",
      "level": "required",
      "probe": {
        "type": "file.exists",
        "path": "LICENSE",
        "kind": "file"
      }
    }
  ],
  "permissions": {
    "commands": [
      {
        "executable": "curl"
      }
    ],
    "networkHosts": ["api.example.com"]
  }
}
